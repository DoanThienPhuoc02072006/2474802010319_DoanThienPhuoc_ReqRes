    {
      "name": "Positive_Cases",
      "item": [
        {
          "name": "POST - Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Validate name and job manually\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.name).to.eql(\"An Nguyen\"); // Thay bằng tên bạn tự nhập\n    pm.expect(jsonData.job).to.eql(\"QA Lead\");   // Thay bằng job bạn tự nhập\n});\n\npm.environment.set(\"userId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"An Nguyen\",\n  \"job\": \"QA Lead\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET - Single User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\npm.test(\"Validate user id and email domain\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData.data.id).to.eql(2);\n    pm.expect(jsonData.data.email).to.include(\"@reqres.in\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}"
              }
